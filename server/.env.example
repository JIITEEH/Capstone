PORT=3001
NODE_ENV=development
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./uploads
CLIENT_ORIGIN=http://localhost:5173
# Number of proxies in front of the server. Set to 1 behind nginx or a hosting platform, or every
# visitor shares one rate limit. Leave empty when the server faces the internet directly.
TRUST_PROXY=
# Limit public sign-up to your school's email domains, comma-separated (e.g. tms.edu,students.tms.edu).
# Leave empty to allow any address. New sign-ups must verify their email either way.
ALLOWED_EMAIL_DOMAINS=
# Use a long random string. Required when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string
# Outgoing email, for password reset links. Leave SMTP_HOST empty to print emails to the console
# in development. Gmail is free: turn on 2-step verification, create an app password at
# https://myaccount.google.com/apppasswords, and use it as SMTP_PASS (not your normal password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Leave empty: port 465 uses TLS from the start and 587 upgrades to it. Set true or false only to override.
SMTP_SECURE=
MAIL_FROM=
# Email for the admin account created by `npm run db:seed`. Defaults to admin@example.edu.
SEED_ADMIN_EMAIL=
# Password for the admin account created by `npm run db:seed` (at least 8 characters).
# Leave it unset to have the seed script generate one and print it.
SEED_ADMIN_PASSWORD=
# Where `npm run db:backup` writes, and how many days of backups to keep.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
# An rclone destination, so backups survive losing this machine. Run `rclone config` once,
# then use the remote's name here, for example gdrive:thesistrack-backups.
# Leave it empty to keep backups on this machine only.
BACKUP_REMOTE=
